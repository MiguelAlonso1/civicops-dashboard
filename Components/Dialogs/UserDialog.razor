<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudStack Spacing="2">
                <MudTextField T="string" @bind-Value="_email" Label="Email" InputType="InputType.Email" Variant="Variant.Outlined" Required="true" RequiredError="Email is required."
                              Validation="@(new Func<string?, string?>(v => v is not null && v.Contains('@') ? null : "Enter a valid email address."))" AutoFocus="true" MaxLength="100" />
                <MudTextField T="string" @bind-Value="_name" Label="Display name" Variant="Variant.Outlined" Required="true" RequiredError="Display name is required." MaxLength="100" />
                <MudSelect T="string" @bind-Value="_role" Label="Role" Variant="Variant.Outlined" Required="true" RequiredError="Choose a role.">
                    @foreach (var r in Roles.All) { <MudSelectItem T="string" Value="@r">@r</MudSelectItem> }
                </MudSelect>
                <MudTextField T="string" @bind-Value="_password" Label="Temporary password" InputType="InputType.Password" Variant="Variant.Outlined" Required="true"
                              RequiredError="Password is required." HelperText="At least 10 characters with upper and lower case, a digit and a symbol."
                              Validation="@(new Func<string?, string?>(v => v is { Length: >= 10 } ? null : "At least 10 characters."))" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Create user</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    private MudForm _form = default!;
    private bool _valid;
    private string? _email, _name, _role = Roles.Agent, _password;

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (_valid) MudDialog.Close(DialogResult.Ok((_email, _name, _role, _password)));
    }
}
